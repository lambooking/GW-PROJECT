@cli.command()
@click.argument('file_path', type=click.Path(exists=True))
@click.pass_context
def score(ctx, file_path):
    """快速文档评分"""
    try:
        print(f"📄 快速评分: {file_path}")
        print("=" * 50)
        
        # 直接使用原版组件避免性能损失
        from src.inference.rag_knowledge_base import RAGKnowledgeBase
        from src.inference.rag_scoring_engine import RAGScoringEngine
        from src.inference.vllm_client import VLLMInferenceClient
        from src.data_processing.preprocessing_pipeline import PreprocessingPipeline
        from src.utils.report_utils import save_scoring_report
        
        print("🔄 初始化组件...")
        
        # 初始化核心组件 (使用原版逻辑)
        kb = RAGKnowledgeBase()
        vllm_client = VLLMInferenceClient(base_url=ctx.obj['base_url'], model_name=ctx.obj['model'])
        scoring_engine = RAGScoringEngine(vllm_client=vllm_client, knowledge_base=kb)
        pipeline = PreprocessingPipeline()
        
        print("📄 处理文档...")
        document = pipeline.process(file_path)
        
        print("⚖️  执行评分...")
        result = scoring_engine.score_document(document)
        
        # 显示结果
        print("\n📊 评分结果:")
        summary = result.get('summary', {})
        print(f"  总分: {summary.get('total_score', 0)}/{summary.get('max_total_score', 100)}")
        print(f"  得分率: {summary.get('percentage', 0):.1f}%")
        print(f"  等级: {summary.get('grade', '未知')}")
        
        # 生成报告 (JSON + HTML)
        output_dir = Path("output/rag_scoring_reports")
        output_dir.mkdir(parents=True, exist_ok=True)
        paths = save_scoring_report(
            scoring_result=result,
            file_stem=Path(file_path).stem,
            output_dir=str(output_dir),
            separate_html_dir=False,
        )
        print("\n📄 报告已保存:")
        print(f"  📋 JSON: {paths['json_path']}")
        if paths.get('html_path'):
            print(f"  🌐 HTML: {paths['html_path']}")
        else:
            print("  🌐 HTML: 生成失败或跳过")
        
        print("✅ 快速评分完成!")
        
    except Exception as e:
        print(f"❌ 评分失败: {e}")
        if ctx.obj['verbose']:
            import traceback
            traceback.print_exc()

@cli.command()
@click.argument('directory', type=click.Path(exists=True))
@click.option('--shared', is_flag=True, default=False, help='共享组件实例以提升性能（可能有状态影响）')
@click.pass_context  
def batch(ctx, directory, shared):
    """快速批量评分"""
    try:
        dir_path = Path(directory)
        pdf_files = list(dir_path.glob("*.pdf"))
        
        print(f"📚 批量评分: {len(pdf_files)} 个文件")
        
        if not pdf_files:
            print("❌ 目录中没有PDF文件")
            return
        
        # 批量处理
        success_count = 0
        output_dir = Path("output/rag_scoring_reports")
        output_dir.mkdir(parents=True, exist_ok=True)

        # 共享模式的可选单例
        shared_resources = None
        if shared:
            try:
                from src.inference.rag_knowledge_base import RAGKnowledgeBase
                from src.inference.rag_scoring_engine import RAGScoringEngine
                from src.inference.vllm_client import VLLMInferenceClient
                from src.data_processing.preprocessing_pipeline import PreprocessingPipeline
                shared_resources = {
                    'kb': RAGKnowledgeBase(),
                    'vllm': VLLMInferenceClient(base_url=ctx.obj['base_url'], model_name=ctx.obj['model']),
                    'pipeline': PreprocessingPipeline(),
                }
                shared_resources['engine'] = RAGScoringEngine(
                    vllm_client=shared_resources['vllm'],
                    knowledge_base=shared_resources['kb']
                )
            except Exception as e:
                print(f"⚠️  共享模式初始化失败，回退到隔离模式: {e}")
                shared = False

        for i, file_path in enumerate(pdf_files, 1):
            try:
                print(f"[{i}/{len(pdf_files)}] {file_path.name}")
                
                # 组件（按模式选择）
                if shared and shared_resources:
                    kb = shared_resources['kb']
                    vllm_client = shared_resources['vllm']
                    scoring_engine = shared_resources['engine']
                    pipeline = shared_resources['pipeline']
                else:
                    from src.inference.rag_knowledge_base import RAGKnowledgeBase
                    from src.inference.rag_scoring_engine import RAGScoringEngine  
                    from src.inference.vllm_client import VLLMInferenceClient
                    from src.data_processing.preprocessing_pipeline import PreprocessingPipeline
                    kb = RAGKnowledgeBase()
                    vllm_client = VLLMInferenceClient(base_url=ctx.obj['base_url'], model_name=ctx.obj['model'])
                    scoring_engine = RAGScoringEngine(vllm_client=vllm_client, knowledge_base=kb)
                    pipeline = PreprocessingPipeline()
                
                document = pipeline.process(str(file_path))
                result = scoring_engine.score_document(document)
                
                summary = result.get('summary', {})
                print(f"    ✅ 评分完成: {summary.get('total_score', 0):.1f}分")
                
                # 生成报告
                from src.utils.report_utils import save_scoring_report
                paths = save_scoring_report(
                    scoring_result=result,
                    file_stem=file_path.stem,
                    output_dir=str(output_dir),
                    separate_html_dir=False,
                )
                if paths.get('html_path'):
                    print(f"    📄 报告: JSON + HTML")
                else:
                    print(f"    📄 报告: JSON only (HTML failed)")
                
                success_count += 1
                
            except Exception as e:
                print(f"    ❌ 失败: {e}")
        
        print(f"\n🎯 批量完成: {success_count}/{len(pdf_files)} 成功")
        
    except Exception as e:
        print(f"❌ 批量处理失败: {e}")

