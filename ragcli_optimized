import click

def create_fast_app():
    """创建快速版应用 - 避免性能瓶颈"""
    
    # 1. 快速配置加载
    from src.config.schemas import Config, VLLMConfig, KnowledgeBaseConfig
    
    # 使用默认配置，避免复杂的YAML解析
    config = Config()
    config.vllm = VLLMConfig(
        host="localhost",
        port=8000,
        model_name="qwen2.5-vl-3b"
    )
    config.knowledge_base = KnowledgeBaseConfig(
        storage_path="output/rag_knowledge_base",
        embedding_model="all-MiniLM-L6-v2"
    )
    
    # 2. 创建应用
    from src.core import RAGScoringApplication
    from src.config import ConfigManager
    
    # 模拟配置管理器
    class FastConfigManager:
        def __init__(self, config):
            self._config = config
            self.vllm = config.vllm
            self.knowledge_base = config.knowledge_base
            self.system = config.system
            self.processing = config.processing
            self.output = config.output
    
    config_manager = FastConfigManager(config)
    app = RAGScoringApplication(config_manager)
    
    return app, config

@click.group()
@click.option('--verbose', '-v', is_flag=True, help='详细输出')
@click.option('--base-url', default='http://localhost:8000/v1', show_default=True, help='VLLM服务地址')
@click.option('--model', default='qwen2.5-vl-3b', show_default=True, help='VLLM模型名')
@click.pass_context
def cli(ctx, verbose, base_url, model):
    """RAG智能评分系统 - 性能优化版"""
    ctx.ensure_object(dict)
    ctx.obj['verbose'] = verbose
    
    if verbose:
        logging.basicConfig(level=logging.INFO)
    ctx.obj['base_url'] = base_url
    ctx.obj['model'] = model

